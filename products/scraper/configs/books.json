{
  "name": "Books to Scrape — product catalog",
  "start_url": "https://books.toscrape.com/catalogue/page-1.html",
  "item": "article.product_pod",
  "next": "li.next > a",
  "unique": "url",
  "fields": {
    "title": { "css": "h3 a", "attr": "title" },
    "price_gbp": { "css": "p.price_color", "type": "float" },
    "rating": { "css": "p.star-rating", "attr": "class", "regex": "star-rating (\\w+)", "map": { "One": "1", "Two": "2", "Three": "3", "Four": "4", "Five": "5" }, "type": "int" },
    "in_stock": { "css": "p.instock.availability" },
    "url": { "css": "h3 a", "attr": "href" },
    "image": { "css": "img", "attr": "src" }
  },
  "detail": {
    "link_field": "url",
    "fields": {
      "category": { "css": "ul.breadcrumb li:nth-of-type(3) a" },
      "upc": { "css": "table.table tr:nth-of-type(1) td" },
      "stock_count": { "css": "p.instock.availability", "regex": "\\((\\d+) available\\)", "type": "int" },
      "description": { "css": "#product_description ~ p" }
    }
  }
}
